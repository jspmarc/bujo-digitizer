# APP_NAME=Bujo Digitizer

# Logging level for the app: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- Docker settings ---
# DOCKER_DATA_DIR=

# --- LLM settings ---
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Models and sampling
OCR_MODEL=chandra-ocr-2
OCR_TEMPERATURE=0.5
OCR_REASONING_BUDGET_TOKENS=3072
PARSER_MODEL=qwen-3.8-27b
PARSER_TEMPERATURE=0.6
PARSER_REASONING_BUDGET_TOKENS=256

# --- Paperless settings ---
PAPERLESS_BASE_URL=
PAPERLESS_TOKEN=
# Required. Id of the tag applied after a review is approved
PAPERLESS_DIGITIZED_TAG_ID=6

# SQLITE_PATH=

# --- worker settings ---
## Number of seconds for the PDF worker to poll the queue
WORKER_POLL_SECONDS=2.0
WORKER_CONCURRENCY=1
## Number of seconds for the worker to requeue failed jobs
WORKER_RETRY_INTERVAL_SECONDS=3600.0
JOB_MAX_ATTEMPTS=3

# --- Obsidian settings ---
OBSIDIAN_BUJO_ENABLED=False
OBSIDIAN_VAULT_PATH=
OBSIDIAN_BUJO_SECTION=Bujo
## Note layout under the vault root: {year}/{week}/file. Placeholders: {year}, {week}, {date}
OBSIDIAN_NOTE_TEMPLATE={year}/W{week:02d}/{date}.md
